@model Product
@{
    var creating = Model.Id == 0;
    ViewData["Title"] = creating ? "Nuevo producto" : "Editar producto";
}
<h1>@ViewData["Title"]</h1>
<form method="post" enctype="multipart/form-data" asp-action="@(creating ? "Create" : "Edit")" asp-route-id="@(creating ? null : Model.Id.ToString())">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="product-fields">
    <div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" required /></div>
    <div class="mb-3"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" placeholder="cafe-tarrazu" aria-describedby="slug-help" required /><div id="slug-help" class="form-text">Identificador del producto. Usa minúsculas sin tildes, números y guiones entre palabras.</div></div>
    <div class="mb-3"><label asp-for="Origen" class="form-label"></label><input asp-for="Origen" class="form-control" required /></div>
    <div class="mb-3"><label asp-for="Proceso" class="form-label"></label><input asp-for="Proceso" class="form-control" required /></div>
    <div class="mb-3"><label asp-for="PuntajeSca" class="form-label"></label><input asp-for="PuntajeSca" class="form-control" type="number" step="0.01" min="0" required /></div>
    <div class="mb-3"><label asp-for="Presentacion" class="form-label"></label><input asp-for="Presentacion" class="form-control" required /></div>
    <div class="mb-3"><label asp-for="PrecioUsd" class="form-label"></label><input asp-for="PrecioUsd" class="form-control" type="number" step="0.01" min="0" required /></div>
    <div class="mb-3"><label asp-for="PrecioCrc" class="form-label"></label><input asp-for="PrecioCrc" class="form-control" type="number" step="0.01" min="0" required /></div>
    </div>
    <div class="mb-3">
        <label for="foto" class="form-label">Foto del café</label>
        @if (!creating && !string.IsNullOrWhiteSpace(Model.Imagen))
        {
            <img src="@Url.Content(Model.Imagen)" alt="Foto actual del café" class="d-block rounded mb-2" width="120" height="120" style="object-fit: cover" />
        }
        <input id="foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp"
               class="form-control" required="@creating" aria-describedby="foto-ayuda" />
        <div id="foto-ayuda" class="form-text">
            JPG, PNG o WebP de hasta 5 MB.
            @if (!creating) { <span>Si dejas el campo vacío, se conserva la foto actual.</span> }
        </div>
    </div>
    <div class="mb-3">
        <label for="notasTexto" class="form-label">Notas de cata (una por línea)</label>
        <textarea id="notasTexto" name="notasTexto" class="form-control">@string.Join("\n", Model.Notas)</textarea>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label"></label>
    </div>
    <button class="btn btn-primary" type="submit">Guardar</button>
    <a asp-action="Index">Cancelar</a>
</form>
@if (!creating)
{
    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="mt-3"
          onsubmit="return confirm('¿Eliminar este producto definitivamente?');">
        <button class="btn btn-outline-danger" type="submit">Eliminar producto</button>
    </form>
}
