@model Product[]
@{ Layout = null; }
<!DOCTYPE html>
<html class="dark" lang="es">
<head>
<meta charset="utf-8"/>
<meta name="theme-color" content="#050505"/>
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>
<title>Javaquero — Café de Especialidad</title>
<link rel="icon" href="/favicon.ico"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&amp;family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="/css/style.css" rel="stylesheet" asp-append-version="true"/>
<script src="https://cdn.tailwindcss.com"></script>
<script src="/js/tailwind-config.js" asp-append-version="true"></script>
</head>
<body class="bg-surface font-body-md text-body-md text-on-surface flex flex-col min-h-screen">

<header class="fixed top-0 w-full z-50 pt-safe public-header bg-surface/85 backdrop-blur-xl shadow-[0_4px_20px_rgba(0,0,0,0.4)]">
  <div class="h-16 px-space-md md:px-space-xl md:max-w-6xl md:mx-auto flex items-center justify-between gap-2">
    <div class="flex items-center gap-space-xs">
      <img alt="Javaquero" class="w-8 h-8 rounded-full object-cover bg-surface-container-lowest" src="/img/logo.png"/>
      <div class="flex flex-col">
        <span class="font-headline-sm text-headline-sm tracking-wide text-primary uppercase leading-tight">Javaquero<sup class="ml-0.5 text-[0.5em]">&reg;</sup></span>
        <span class="font-label-sm text-label-sm tracking-widest text-on-surface-variant uppercase lg:hidden" id="header-subtitle">Inicio</span>
      </div>
    </div>
    <nav class="hidden lg:flex items-center gap-space-lg">
      <a class="font-label-md text-label-md uppercase tracking-widest transition-colors text-primary" data-path="inicio" href="#inicio">Inicio</a>
      <a class="font-label-md text-label-md uppercase tracking-widest transition-colors text-on-surface-variant hover:text-primary" data-path="cafes" href="#cafes">Cafés</a>
      <a class="font-label-md text-label-md uppercase tracking-widest transition-colors text-on-surface-variant hover:text-primary" data-path="nosotros" href="#nosotros">Nosotros</a>
      <a class="font-label-md text-label-md uppercase tracking-widest transition-colors text-on-surface-variant hover:text-primary" data-path="contacto" href="#contacto">Contacto</a>
    </nav>
    <a class="public-admin-link" asp-controller="Admin" asp-action="Index">
      <span class="material-symbols-outlined" aria-hidden="true">lock</span>
      <span>Administración</span>
    </a>
  </div>
</header>

<main class="flex flex-col relative w-full public-main bg-surface min-h-screen">
<div class="flex flex-col w-full text-on-surface">

  <!-- HERO SECTION -->
  <section class="relative w-full public-hero overflow-hidden" id="inicio">
    <img alt="JAVAQUERO Espresso artesanal con crema dorada" class="absolute inset-0 w-full h-full object-cover object-center" src="/img/hero-espresso.jpg"/>
    <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/75 to-surface/30"></div>
    <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-80 h-80 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 w-full px-space-md pt-space-xl pb-space-2xl md:px-space-xl md:pb-space-3xl md:max-w-6xl md:mx-auto flex flex-col items-center justify-end text-center md:items-start md:text-left">
      <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface font-semibold max-w-sm md:max-w-lg mb-space-sm leading-tight">
        Nobleza, Pasión y <span class="text-primary italic">Tueste Perfecto</span>
      </h1>
      <p class="font-body-md text-body-md md:font-body-lg md:text-body-lg text-on-surface-variant max-w-xs md:max-w-md mb-space-lg">
        Microlotes de estricta altura seleccionados grano a grano. Tostados artesanalmente en pequeños lotes para revelar notas sensoriales inolvidables.
      </p>

      <div class="w-full flex flex-col gap-space-sm max-w-xs">
        <a class="w-full py-3.5 px-space-md rounded-full bg-primary text-on-primary font-label-lg text-label-lg uppercase tracking-wider flex items-center justify-center gap-space-xs shadow-[0_0_24px_rgba(212,175,55,0.3)] active:scale-98 transition-all" href="#cafes">
          <span>Ver Cafés Disponibles</span>
          <span class="material-symbols-outlined text-lg">arrow_downward</span>
        </a>
      </div>
    </div>
  </section>

  <!-- BANNER NOTA PEDIDOS DIRECTOS -->
  <div class="mx-space-md mb-space-2xl px-space-md py-space-sm md:max-w-6xl md:mx-auto rounded-xl bg-surface-container flex items-center gap-space-sm shadow-md">
    <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
      <span class="material-symbols-outlined text-primary text-xl">loyalty</span>
    </div>
    <div class="flex flex-col text-left">
      <span class="font-title-md text-title-md text-primary leading-tight">Atención 100% Personalizada</span>
      <p class="font-body-sm text-body-sm text-on-surface-variant">Sin carritos automáticos ni intermediarios. Cada pedido se agenda y tuesta directo a través de WhatsApp.</p>
    </div>
  </div>

  <!-- SECTION: PRODUCTOS (#cafes) -->
  <section class="px-space-md py-space-xl md:max-w-6xl md:mx-auto md:px-space-xl md:py-space-2xl flex flex-col scroll-mt-20" id="cafes">
    <div class="flex flex-col items-start mb-space-lg">
      <div class="flex items-center gap-space-2xs mb-space-2xs">
        <span class="material-symbols-outlined text-primary text-sm">coffee</span>
        <span class="font-label-md text-label-md uppercase tracking-widest text-primary">Colección Reservada</span>
      </div>
      <h2 class="font-headline-sm text-headline-sm md:font-headline-md md:text-headline-md text-on-surface font-semibold">
        Nuestra Selección de Temporada
      </h2>
      <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
        Microlotes de pureza excepcional listos para molerse a tu gusto y ser enviados a tu puerta.
      </p>
    </div>


    @if (Model is null)
    {
      <p>El catálogo no está disponible en este momento. Puedes consultarnos por WhatsApp.</p>
    }
    else if (Model.Length == 0)
    {
      <p>Por el momento no hay cafés disponibles.</p>
    }
    else
    {
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg w-full" id="products-list">
        @foreach (var product in Model)
        {
          <partial name="_ProductCard" model="product" />
        }
      </div>
    }
  </section>

  <section class="coffee-story scroll-mt-20" id="nosotros" aria-labelledby="historia-titulo">
    <div class="story-wrap">
      <header class="story-intro">
        <div>
          <p class="story-origin">Santa María de Dota · Costa Rica</p>
          <h2 id="historia-titulo">La historia de <em>Javaquero</em></h2>
          <p>En Santa María de Dota, Carlos aprendió a recoger café con su familia. Hoy, con Javaquero, quiere que una taza lleve hasta otras mesas el sabor de su pueblo y el trabajo de quienes lo cultivan.</p>
        </div>
        <figure class="story-quote">
          <blockquote>«Haber nacido en Santa María de Dota, realmente es una bendición para mí.»</blockquote>
          <figcaption>Carlos, fundador de Javaquero</figcaption>
        </figure>
      </header>

      <div class="story-chapters">
        <article class="story-chapter">
          <h3>Una infancia entre cafetales</h3>
          <p>Para Carlos, nacer en Santa María de Dota fue una bendición. Ahí aprendió el valor del respeto y del trabajo, entre montañas y gente que disfruta lo que hace. Sus recuerdos más queridos son de la infancia, cuando salía a recolectar café con su familia, almorzaban en el cafetal y vacilaban entre ellos. De quienes ya fallecieron conserva las enseñanzas y el cariño de esos días.</p>
          <p>Sus abuelos maternos y paternos y su papá le transmitieron el amor por el grano de oro. Los recuerda trabajando en las fincas junto a los peones agrícolas, abonando, deshijando las matas para que crecieran con más fuerza y recogiendo las cerezas. También recuerda medir el café antes de llevarlo a la cooperativa.</p>
        </article>
        <article class="story-chapter">
          <h3>Cómo nació Javaquero</h3>
          <p>Carlos creó Javaquero al interesarse por nuevas prácticas cafetaleras. Quería vivir de lo que le gusta y dar a conocer el café de especialidad de Dota en lugares donde todavía es poco conocido.</p>
          <p><strong class="text-on-surface">Java</strong> alude a la isla de Indonesia ligada a la historia del café arábica. <strong class="text-on-surface">Quero</strong> evoca a los finqueros, cafetaleros y ganaderos. Carlos reunió esas dos referencias en un nombre inventado que reconoce a la gente que trabaja la tierra.</p>
        </article>
      </div>

      <article class="story-natural" aria-labelledby="natural-titulo">
        <header>
          <h3 id="natural-titulo">Javaquero Natural</h3>
          <dl class="story-natural-details">
            <div><dt>Variedad</dt><dd>Catuaí</dd></div>
            <div><dt>Altura</dt><dd>1.950–2.100 m s. n. m.</dd></div>
            <div><dt>Cosecha</dt><dd>Noviembre a marzo</dd></div>
          </dl>
        </header>
        <div class="story-natural-copy">
          <p>El Catuaí de proceso natural que Carlos cultiva en Santa María de Dota recuerda al mango maduro y a los frutos rojos, con notas de chocolate y un toque de vino afrutado. En boca tiene una acidez cítrica de media a alta, cuerpo medio y textura cremosa.</p>
          <p>Tras la recolección, las cerezas pasan a camas de secado. Carlos describe un reposo de dos a tres meses antes de continuar con el procesamiento, el almacenamiento y el tueste.</p>
        </div>
      </article>

      <div class="story-chapters story-closing">
        <article class="story-chapter">
          <h3>De Dota a otras mesas</h3>
          <p>Proteger el fruto de las plagas y cubrir el costo de los insumos y nutrientes son dos de los retos de producir este café. A Carlos le enorgullece que ese esfuerzo llegue a la mesa de alguien que quizá nunca ha visto un cafetal.</p>
          <p>Cuando alguien en Estados Unidos pruebe Javaquero, Carlos quiere que reconozca el trabajo y el cariño de las familias caficultoras de Dota. Y si esa taza le despierta curiosidad, lo invita a conocer las montañas, ver de cerca las cerezas y visitar los microbeneficios y las cafeterías para recorrer el camino del café hasta la taza.</p>
        </article>
        <article class="story-chapter">
          <h3>La vida alrededor del café</h3>
          <p>En Dota, el día empieza temprano con una taza de café chorreado antes de salir a la finca. Al volver, hay tiempo para compartir con los vecinos. Cuando Carlos está lejos, extraña el olor a tierra mojada, los cafetales y la gente del pueblo. A quien visite Dota también le recomienda probar su comida casera, acercarse a las fiestas con boyeros y desfiles de emblemas, y visitar un trapiche.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- SECTION: CONTACTO & CONCIERGE (#contacto) -->
  <section class="px-space-md py-space-2xl md:max-w-2xl md:mx-auto md:px-space-xl flex flex-col scroll-mt-20" id="contacto">
    <div class="flex flex-col items-start mb-space-md">
      <div class="flex items-center gap-space-2xs mb-space-2xs">
        <span class="material-symbols-outlined text-primary text-sm">support_agent</span>
        <span class="font-label-md text-label-md uppercase tracking-widest text-primary">Servicio y Cupping</span>
      </div>
      <h2 class="font-headline-sm text-headline-sm text-on-surface font-semibold">
        Contacto
      </h2>
      <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
        Escríbenos para conocer disponibilidad, tiempos de tueste y coordinar el envío de tu pedido.
      </p>
    </div>

    <div class="p-space-md rounded-2xl bg-surface-container flex flex-col gap-space-md mb-space-md shadow-lg">
      <div class="flex items-start gap-space-sm">
        <span class="material-symbols-outlined text-primary text-xl mt-0.5">schedule</span>
        <div>
          <span class="font-label-sm text-label-sm text-outline uppercase font-semibold">Horario de Atención y Despacho</span>
          <p class="font-body-md text-body-md text-on-surface">Lunes a Sábado: 8:00 AM – 7:00 PM</p>
        </div>
      </div>
      <div class="flex items-start gap-space-sm">
        <span class="material-symbols-outlined text-primary text-xl mt-0.5">storefront</span>
        <div>
          <span class="font-label-sm text-label-sm text-outline uppercase font-semibold">Tostaduría &amp; Laboratorio</span>
          <p class="font-body-md text-body-md text-on-surface">Santa María de Dota, Costa Rica</p>
        </div>
      </div>
      <div class="flex items-start gap-space-sm">
        <span class="material-symbols-outlined text-primary text-xl mt-0.5">mark_email_read</span>
        <div>
          <span class="font-label-sm text-label-sm text-outline uppercase font-semibold">Correo Electrónico</span>
          <p class="font-body-md text-body-md text-on-surface">concierge@javaquero.coffee</p>
        </div>
      </div>
    </div>

    <a class="w-full py-4 px-space-md rounded-2xl bg-primary text-on-primary font-label-lg text-label-lg uppercase tracking-wider flex items-center justify-center gap-space-xs shadow-[0_0_20px_rgba(212,175,55,0.3)] active:scale-98 transition-all" data-wa-message="Hola Javaquero, quiero comprar café de tueste medio" href="#" rel="noopener noreferrer" target="_blank">
      <span class="material-symbols-outlined text-xl">forum</span>
      <span>Escríbenos por WhatsApp</span>
    </a>
  </section>

</div>

<footer class="mt-space-3xl px-space-md pt-space-2xl pb-40 lg:pb-space-3xl bg-surface-container-lowest text-on-surface-variant flex flex-col gap-space-xl">
 <div class="w-full md:max-w-6xl md:mx-auto flex flex-col gap-space-xl md:grid md:grid-cols-3 md:gap-space-2xl">
  <div class="flex flex-col gap-space-xs">
    <div class="flex items-center gap-space-xs">
      <span class="material-symbols-outlined text-primary">workspace_premium</span>
      <span class="font-headline-sm text-headline-sm text-primary uppercase">Javaquero</span>
    </div>
    <p class="font-body-sm text-body-sm text-on-surface-variant max-w-xs">Micro-lotes selectos y tueste artesanal de alta cuna. La máxima reverencia a la herencia cafetalera y el perfil sensorial supremo.</p>
  </div>
  <div class="py-space-sm md:py-0">
    <div class="flex flex-col gap-space-2xs p-space-sm rounded-DEFAULT bg-surface-container-low max-w-[10rem]">
      <span class="font-label-sm text-label-sm text-primary uppercase">Origen</span>
      <span class="font-title-md text-title-md text-on-surface">1,900 msnm</span>
      <span class="font-body-sm text-body-sm text-outline">Estricta Altura</span>
    </div>
  </div>
  <div class="flex flex-col gap-space-xs">
    <span class="font-label-md text-label-md text-primary uppercase tracking-widest">Contacto &amp; Cupping Room</span>
    <div class="flex items-center gap-space-xs">
      <span class="material-symbols-outlined text-base text-primary">pin_drop</span>
      <span class="font-body-sm text-body-sm text-on-surface">Santa María de Dota, Costa Rica</span>
    </div>
    <div class="flex items-center gap-space-xs">
      <span class="material-symbols-outlined text-base text-primary">mail</span>
      <span class="font-body-sm text-body-sm text-on-surface">concierge@javaquero.coffee</span>
    </div>
  </div>
 </div>
  <div class="pt-space-md flex flex-col gap-space-2xs items-center text-center">
    <p class="font-label-sm text-label-sm text-outline uppercase tracking-wider">© 2026 Javaquero Specialty Coffee. All rights reserved.</p>
    <p class="font-body-sm text-body-sm text-on-surface-variant">Sitio web desarrollado por <span class="text-primary font-semibold">Abraham Cascante</span>.</p>
  </div>
</footer>

</main>

<a aria-label="Chat on WhatsApp" class="fixed bottom-24 md:bottom-8 right-space-md md:right-space-xl z-40 w-12 h-12 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-[0_0_20px_rgba(212,175,55,0.35)] hover:scale-105 active:scale-95 transition-all duration-200" data-wa-message="Hola Javaquero, quiero comprar café de tueste medio" href="#" rel="noopener noreferrer" target="_blank">
  <span class="material-symbols-outlined text-2xl">chat</span>
</a>

<nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-4px_24px_rgba(0,0,0,0.6)] lg:hidden" data-active-classes="text-primary">
  <div class="flex justify-around items-center h-16 px-space-xs">
    <a aria-current="page" class="flex flex-col items-center justify-center gap-space-2xs min-w-[44px] min-h-[44px] px-space-xs transition-colors text-primary" data-path="inicio" href="#inicio">
      <span class="material-symbols-outlined text-xl">home</span>
      <span class="font-label-sm text-label-sm uppercase">Inicio</span>
    </a>
    <a class="flex flex-col items-center justify-center gap-space-2xs min-w-[44px] min-h-[44px] px-space-xs text-on-surface-variant hover:text-on-surface transition-colors" data-path="cafes" href="#cafes">
      <span class="material-symbols-outlined text-xl">coffee</span>
      <span class="font-label-sm text-label-sm uppercase">Cafés</span>
    </a>
    <a class="flex flex-col items-center justify-center gap-space-2xs min-w-[44px] min-h-[44px] px-space-xs text-on-surface-variant hover:text-on-surface transition-colors" data-path="nosotros" href="#nosotros">
      <span class="material-symbols-outlined text-xl">auto_awesome</span>
      <span class="font-label-sm text-label-sm uppercase">Nosotros</span>
    </a>
    <a class="flex flex-col items-center justify-center gap-space-2xs min-w-[44px] min-h-[44px] px-space-xs text-on-surface-variant hover:text-on-surface transition-colors" data-path="contacto" href="#contacto">
      <span class="material-symbols-outlined text-xl">contact_support</span>
      <span class="font-label-sm text-label-sm uppercase">Contacto</span>
    </a>
  </div>
</nav>

<script src="/js/main.js" asp-append-version="true"></script>
</body>
</html>
